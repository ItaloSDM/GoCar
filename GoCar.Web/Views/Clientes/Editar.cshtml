@model GoCar.Web.Models.ClienteViewModel

@{
    ViewData["Title"] = "Editar Cliente";

    var iniciais = "?";

    if (!string.IsNullOrWhiteSpace(Model.Nome))
    {
        var partes = Model.Nome
            .Split(' ', StringSplitOptions.RemoveEmptyEntries);

        iniciais = partes.Length >= 2
            ? $"{partes[0][0]}{partes[^1][0]}".ToUpper()
            : partes[0][0].ToString().ToUpper();
    }
}

<style>
    .client-edit-page {
        max-width: 1500px;
        margin: auto;
        padding: 32px;
        color: #fff;
    }

    .client-edit-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 24px;
    }

    .client-edit-eyebrow {
        margin-bottom: 4px;
        color: #8d849a;
        font-size: .7rem;
        text-transform: uppercase;
        letter-spacing: .6px;
    }

    .client-edit-title {
        margin: 0;
        color: #fff;
        font-size: 1.85rem;
        font-weight: 800;
    }

    .client-edit-description {
        margin: 6px 0 0;
        color: #81778e;
        font-size: .8rem;
    }

    .edit-btn-secondary,
    .edit-btn-primary {
        min-height: 40px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0 16px;
        border-radius: 8px;
        text-decoration: none;
        font-size: .7rem;
        font-weight: 700;
        transition: .18s ease;
    }

    .edit-btn-secondary {
        border: 1px solid rgba(151,71,255,.24);
        background: rgba(126,44,255,.06);
        color: #bca9d4;
    }

        .edit-btn-secondary:hover {
            color: #fff;
            background: rgba(126,44,255,.12);
        }

    .edit-btn-primary {
        border: 1px solid #8b3dff;
        background: linear-gradient(135deg,#7c2cff,#9b4dff);
        color: #fff;
        cursor: pointer;
        box-shadow: 0 8px 25px rgba(126,44,255,.18);
    }

        .edit-btn-primary:hover {
            transform: translateY(-1px);
        }

    .client-edit-profile {
        display: flex;
        align-items: center;
        gap: 16px;
        margin-bottom: 16px;
        padding: 20px 22px;
        border: 1px solid rgba(151,71,255,.16);
        border-radius: 11px;
        background: radial-gradient(circle at 90% 20%,rgba(126,44,255,.12),transparent 30%), linear-gradient(145deg,rgba(21,11,37,.98),rgba(13,7,24,.98));
    }

    .client-edit-avatar {
        width: 54px;
        height: 54px;
        flex: 0 0 54px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid rgba(151,71,255,.25);
        border-radius: 50%;
        background: rgba(126,44,255,.10);
        color: #c49aff;
        font-size: .9rem;
        font-weight: 800;
    }

    .client-edit-profile small {
        color: #766c81;
        font-size: .56rem;
        text-transform: uppercase;
        letter-spacing: .5px;
    }

    .client-edit-profile h2 {
        margin: 3px 0 0;
        color: #fff;
        font-size: 1rem;
        font-weight: 750;
    }

    .client-edit-card {
        overflow: hidden;
        border: 1px solid rgba(151,71,255,.16);
        border-radius: 11px;
        background: linear-gradient(145deg,rgba(21,11,37,.98),rgba(13,7,24,.98));
    }

    .client-edit-section {
        padding: 22px;
        border-bottom: 1px solid rgba(255,255,255,.045);
    }

    .edit-section-heading {
        margin-bottom: 18px;
    }

        .edit-section-heading small {
            display: block;
            margin-bottom: 3px;
            color: #766c81;
            font-size: .56rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .55px;
        }

        .edit-section-heading h3 {
            margin: 0;
            color: #fff;
            font-size: .9rem;
            font-weight: 700;
        }

    .edit-form-grid {
        display: grid;
        grid-template-columns: repeat(12,minmax(0,1fr));
        gap: 15px;
    }

    .edit-col-4 {
        grid-column: span 4;
    }

    .edit-col-6 {
        grid-column: span 6;
    }

    .edit-col-8 {
        grid-column: span 8;
    }

    .edit-col-12 {
        grid-column: span 12;
    }

    .edit-field label {
        display: block;
        margin-bottom: 6px;
        color: #aaa0b5;
        font-size: .62rem;
        font-weight: 700;
    }

    .edit-input {
        width: 100%;
        min-height: 41px;
        padding: 9px 11px;
        border: 1px solid rgba(151,71,255,.17);
        border-radius: 7px;
        outline: none;
        background: rgba(255,255,255,.025);
        color: #ded8e5;
        font-size: .7rem;
        transition: .15s ease;
    }

        .edit-input:focus {
            border-color: rgba(151,71,255,.65);
            background: rgba(126,44,255,.045);
            box-shadow: 0 0 0 3px rgba(126,44,255,.07);
        }

    .edit-validation {
        display: block;
        margin-top: 5px;
        color: #ff718d;
        font-size: .56rem;
    }

    .validation-summary-errors {
        margin-bottom: 18px;
        padding: 12px 14px;
        border: 1px solid rgba(244,63,94,.22);
        border-radius: 8px;
        background: rgba(244,63,94,.07);
        color: #ff91a7;
        font-size: .65rem;
    }

        .validation-summary-errors ul {
            margin: 0;
            padding-left: 18px;
        }

    .client-active-box {
        display: flex;
        align-items: center;
        min-height: 46px;
        padding: 12px 14px;
        border: 1px solid rgba(151,71,255,.13);
        border-radius: 8px;
        background: rgba(126,44,255,.025);
    }

    .client-active-check {
        display: flex;
        align-items: center;
        gap: 10px;
    }

        .client-active-check input {
            width: 17px;
            height: 17px;
            margin: 0;
            accent-color: #8b3dff;
            cursor: pointer;
        }

        .client-active-check label {
            margin: 0;
            color: #c6bdcf;
            font-size: .67rem;
            font-weight: 700;
            cursor: pointer;
        }

    .client-edit-footer {
        display: flex;
        justify-content: flex-end;
        gap: 8px;
        padding: 18px 22px;
        background: rgba(6,3,11,.22);
    }

    @@media (max-width: 850px) {
        .edit-col-4,
        .edit-col-8 {
            grid-column: span 6;
        }
    }

    @@media (max-width: 650px) {
        .client-edit-page {
            padding: 20px 15px;
        }

        .client-edit-header {
            align-items: flex-start;
            flex-direction: column;
        }

            .client-edit-header > a {
                width: 100%;
            }

        .edit-col-4,
        .edit-col-6,
        .edit-col-8 {
            grid-column: span 12;
        }

        .client-edit-footer {
            flex-direction: column-reverse;
        }

            .client-edit-footer a,
            .client-edit-footer button {
                width: 100%;
            }
    }
</style>

<div class="client-edit-page">

    <div class="client-edit-header">

        <div>
            <div class="client-edit-eyebrow">
                Gestão de clientes
            </div>

            <h1 class="client-edit-title">
                Editar Cliente
            </h1>

            <p class="client-edit-description">
                Atualize os dados pessoais, habilitação e endereço.
            </p>
        </div>

        <a asp-controller="Clientes"
           asp-action="Detalhes"
           asp-route-id="@Model.Id"
           class="edit-btn-secondary">
            ← Detalhes
        </a>

    </div>

    <div class="client-edit-profile">

        <div class="client-edit-avatar">
            @iniciais
        </div>

        <div>
            <small>
                Cliente #@Model.Id
            </small>

            <h2>
                @Model.Nome
            </h2>
        </div>

    </div>

    <div class="client-edit-card">

        <form asp-controller="Clientes"
              asp-action="Editar"
              asp-route-id="@Model.Id"
              method="post">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   asp-for="Id" />

            <input type="hidden"
                   asp-for="DataCadastro" />

            <div class="client-edit-section">

                <div asp-validation-summary="ModelOnly">
                </div>

                <div class="edit-section-heading">
                    <small>Cadastro</small>
                    <h3>Dados pessoais</h3>
                </div>

                <div class="edit-form-grid">

                    <div class="edit-field edit-col-6">
                        <label asp-for="Nome">Nome</label>

                        <input asp-for="Nome"
                               class="edit-input" />

                        <span asp-validation-for="Nome"
                              class="edit-validation">
                        </span>
                    </div>

                    <div class="edit-field edit-col-6">
                        <label asp-for="CPF">CPF</label>

                        <input asp-for="CPF"
                               class="edit-input" />

                        <span asp-validation-for="CPF"
                              class="edit-validation">
                        </span>
                    </div>

                    <div class="edit-field edit-col-6">
                        <label asp-for="DataNascimento">
                            Data de Nascimento
                        </label>

                        <input asp-for="DataNascimento"
                               type="date"
                               class="edit-input" />
                    </div>

                    <div class="edit-field edit-col-6">
                        <label asp-for="Telefone">
                            Telefone
                        </label>

                        <input asp-for="Telefone"
                               class="edit-input" />
                    </div>

                </div>

            </div>

            <div class="client-edit-section">

                <div class="edit-section-heading">
                    <small>Habilitação</small>
                    <h3>Dados da CNH</h3>
                </div>

                <div class="edit-form-grid">

                    <div class="edit-field edit-col-4">
                        <label asp-for="CNH">CNH</label>

                        <input asp-for="CNH"
                               class="edit-input" />
                    </div>

                    <div class="edit-field edit-col-4">
                        <label asp-for="CategoriaCNH">
                            Categoria CNH
                        </label>

                        <input asp-for="CategoriaCNH"
                               class="edit-input" />
                    </div>

                    <div class="edit-field edit-col-4">
                        <label asp-for="DataValidadeCNH">
                            Validade da CNH
                        </label>

                        <input asp-for="DataValidadeCNH"
                               type="date"
                               class="edit-input" />
                    </div>

                </div>

            </div>

            <div class="client-edit-section">

                <div class="edit-section-heading">
                    <small>Localização</small>
                    <h3>Endereço do cliente</h3>
                </div>

                <div class="edit-form-grid">

                    <div class="edit-field edit-col-8">
                        <label asp-for="Endereco">
                            Endereço
                        </label>

                        <input asp-for="Endereco"
                               class="edit-input" />
                    </div>

                    <div class="edit-field edit-col-4">
                        <label asp-for="Numero">
                            Número
                        </label>

                        <input asp-for="Numero"
                               class="edit-input" />
                    </div>

                    <div class="edit-field edit-col-4">
                        <label asp-for="Bairro">
                            Bairro
                        </label>

                        <input asp-for="Bairro"
                               class="edit-input" />
                    </div>

                    <div class="edit-field edit-col-4">
                        <label asp-for="CEP">
                            CEP
                        </label>

                        <input asp-for="CEP"
                               class="edit-input" />
                    </div>

                    <div class="edit-field edit-col-4">
                        <label asp-for="Estado">
                            Estado
                        </label>

                        <input asp-for="Estado"
                               class="edit-input" />
                    </div>

                    <div class="edit-field edit-col-6">
                        <label asp-for="Cidade">
                            Cidade
                        </label>

                        <input asp-for="Cidade"
                               class="edit-input" />
                    </div>

                    <div class="edit-field edit-col-6">
                        <label>Situação do cadastro</label>

                        <div class="client-active-box">
                            <div class="client-active-check">

                                <input asp-for="IsAtivo" />

                                <label asp-for="IsAtivo">
                                    Cliente ativo
                                </label>

                            </div>
                        </div>
                    </div>

                </div>

            </div>

            <div class="client-edit-footer">

                <a asp-controller="Clientes"
                   asp-action="Index"
                   class="edit-btn-secondary">
                    Cancelar
                </a>

                <button type="submit"
                        class="edit-btn-primary">
                    Salvar Alterações
                </button>

            </div>

        </form>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}