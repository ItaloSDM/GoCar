<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - GoCar</title>

    <script type="importmap"></script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/GoCar.Web.styles.css" asp-append-version="true" />
</head>

<body class="gocar-body">

    @{
        var usuarioNome = Context.Session.GetString("UsuarioNome");
        var usuarioPerfil = Context.Session.GetString("UsuarioPerfil");

        var usuarioLogado = !string.IsNullOrWhiteSpace(usuarioNome);

        var ehFuncionario =
            usuarioPerfil == "Administrador"
            || usuarioPerfil == "Gerente"
            || usuarioPerfil == "Atendente";

        var ehCliente =
            usuarioPerfil == "Cliente";
    }

    <header class="gocar-header">
        <nav class="navbar navbar-expand-lg navbar-dark">
            <div class="container">

                <a class="navbar-brand gocar-logo"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">

                    GoCar
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#gocarNavbar"
                        aria-controls="gocarNavbar"
                        aria-expanded="false"
                        aria-label="Abrir menu">

                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse"
                     id="gocarNavbar">

                    <ul class="navbar-nav mx-auto">

                        <li class="nav-item">
                            <a class="nav-link gocar-nav-link"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Index">

                                Início
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link gocar-nav-link"
                               href="/#veiculos">

                                Veículos
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link gocar-nav-link"
                               href="/#como-funciona">

                                Como funciona
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link gocar-nav-link"
                               href="/#sobre">

                                Sobre
                            </a>
                        </li>

                    </ul>

                    <div class="d-flex align-items-center gap-3">

                        @if (usuarioLogado)
                        {
                            <span class="text-white">
                                Olá, @usuarioNome
                            </span>

                            @if (ehFuncionario)
                            {
                                <a class="gocar-btn-outline"
                                   asp-controller="Dashboard"
                                   asp-action="Index">

                                    Dashboard
                                </a>
                            }
                            else if (ehCliente)
                            {
                                <a class="gocar-btn-outline"
                                   asp-controller="Reservas"
                                   asp-action="Index">

                                    Minhas Reservas
                                </a>
                            }

                            <form asp-controller="Account"
                                  asp-action="Logout"
                                  method="post"
                                  class="m-0">

                                <button type="submit"
                                        class="btn gocar-login-btn">

                                    Sair
                                </button>

                            </form>
                        }
                        else
                        {
                            <a class="btn gocar-login-btn"
                               asp-controller="Account"
                               asp-action="Login">

                                Entrar
                            </a>
                        }

                    </div>

                </div>

            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="gocar-footer">

        <div class="container">

            <div class="row">

                <div class="col-md-4">

                    <h5 class="gocar-footer-logo">
                        GoCar
                    </h5>

                    <p>
                        Sua jornada começa aqui.
                        Alugue seu carro de forma simples,
                        rápida e segura.
                    </p>

                </div>

                <div class="col-md-4">

                    <h6>Navegação</h6>

                    <ul class="list-unstyled">

                        <li>
                            <a asp-controller="Home"
                               asp-action="Index">

                                Início
                            </a>
                        </li>

                        <li>
                            <a href="/#veiculos">
                                Veículos
                            </a>
                        </li>

                        <li>
                            <a href="/#como-funciona">
                                Como funciona
                            </a>
                        </li>

                    </ul>

                </div>

                <div class="col-md-4">

                    <h6>Contato</h6>

                    <p>
                        contato@gocar.com
                    </p>

                    <p>
                        São Paulo - SP
                    </p>

                </div>

            </div>

            <hr />

            <div class="text-center gocar-copyright">

                © 2026 GoCar.
                Todos os direitos reservados.

            </div>

        </div>

    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true">
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>