@model GoCar.Web.Models.PagamentoViewModel

@{
    ViewData["Title"] = "Detalhes do Pagamento";

    string StatusPagamento(int status)
    {
        return status switch
        {
            1 => "Pendente",
            2 => "Pago",
            3 => "Cancelado",
            4 => "Estornado",
            _ => "Desconhecido"
        };
    }

    string FormaPagamento(int forma)
    {
        return forma switch
        {
            1 => "Pix",
            2 => "Cartão de Crédito",
            3 => "Cartão de Débito",
            4 => "Dinheiro",
            _ => "Desconhecida"
        };
    }

    bool ehEntrada =
        string.Equals(
            Model.Tipo,
            "Entrada",
            StringComparison.OrdinalIgnoreCase);

    string TipoPagamento()
    {
        if (ehEntrada)
        {
            return "Entrada da Reserva";
        }

        if (string.Equals(
            Model.Tipo,
            "Locação",
            StringComparison.OrdinalIgnoreCase))
        {
            return "Saldo da Locação";
        }

        return Model.Tipo ?? "Não informado";
    }
}

<section class="gocar-section">
    <div class="container">

        <div class="d-flex justify-content-between align-items-center mb-5 flex-wrap gap-3">

            <div>

                <h1 class="fw-bold mb-1">
                    Pagamento #@Model.Id
                </h1>

                <p class="text-muted mb-0">

                    @if (Model.ReservaId.HasValue)
                    {
                        <span>
                            Detalhes do pagamento da reserva.
                        </span>
                    }
                    else if (Model.LocacaoId.HasValue)
                    {
                        <span>
                            Detalhes do pagamento da locação.
                        </span>
                    }
                    else
                    {
                        <span>
                            Detalhes do pagamento.
                        </span>
                    }

                </p>

            </div>

            <div class="d-flex gap-2 flex-wrap">

                <a asp-controller="Pagamentos"
                   asp-action="Index"
                   class="btn btn-outline-dark">
                    Voltar
                </a>

                @if (Model.LocacaoId.HasValue)
                {
                    <a asp-controller="Locacoes"
                       asp-action="Detalhes"
                       asp-route-id="@Model.LocacaoId"
                       class="btn btn-dark">
                        Ver Locação
                    </a>
                }

                @if (Model.ReservaId.HasValue)
                {
                    <a asp-controller="Reservas"
                       asp-action="Detalhes"
                       asp-route-id="@Model.ReservaId"
                       class="btn btn-dark">
                        Ver Reserva
                    </a>
                }

            </div>

        </div>

        @if (TempData["Sucesso"] != null)
        {
            <div class="alert alert-success">
                @TempData["Sucesso"]
            </div>
        }

        @if (TempData["Erro"] != null)
        {
            <div class="alert alert-danger">
                @TempData["Erro"]
            </div>
        }

        <div class="card shadow-sm border-0">

            <div class="card-body p-4">

                <div class="row g-4">

                    <div class="col-md-6">

                        <strong>
                            ID do pagamento
                        </strong>

                        <div class="text-muted">
                            #@Model.Id
                        </div>

                    </div>

                    <div class="col-md-6">

                        @if (Model.ReservaId.HasValue)
                        {
                            <strong>
                                Reserva
                            </strong>

                            <div class="text-muted">
                                #@Model.ReservaId
                            </div>
                        }
                        else if (Model.LocacaoId.HasValue)
                        {
                            <strong>
                                Locação
                            </strong>

                            <div class="text-muted">
                                #@Model.LocacaoId
                            </div>
                        }
                        else
                        {
                            <strong>
                                Vínculo
                            </strong>

                            <div class="text-muted">
                                Não informado
                            </div>
                        }

                    </div>

                    <div class="col-md-6">

                        <strong>
                            Tipo
                        </strong>

                        <div class="text-muted">
                            @TipoPagamento()
                        </div>

                    </div>

                    <div class="col-md-6">

                        <strong>
                            Forma de pagamento
                        </strong>

                        <div class="text-muted">
                            @FormaPagamento(Model.FormaPagamento)
                        </div>

                    </div>

                    <div class="col-md-6">

                        <strong>
                            Status
                        </strong>

                        <div class="mt-1">

                            @if (Model.Status == 1)
                            {
                                <span class="badge bg-warning text-dark">
                                    Pendente
                                </span>
                            }
                            else if (Model.Status == 2)
                            {
                                <span class="badge bg-success">
                                    Pago
                                </span>
                            }
                            else if (Model.Status == 3)
                            {
                                <span class="badge bg-danger">
                                    Cancelado
                                </span>
                            }
                            else if (Model.Status == 4)
                            {
                                <span class="badge bg-secondary">
                                    Estornado
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    @StatusPagamento(Model.Status)
                                </span>
                            }

                        </div>

                    </div>

                    <div class="col-md-6">

                        <strong>
                            Valor
                        </strong>

                        <div class="text-muted fw-semibold">
                            @Model.Valor.ToString("C")
                        </div>

                    </div>

                    <div class="col-md-6">

                        <strong>
                            Data do pagamento
                        </strong>

                        <div class="text-muted">

                            @if (Model.DataPagamento.HasValue)
                            {
                                @Model.DataPagamento.Value.ToString("dd/MM/yyyy HH:mm")
                            }
                            else
                            {
                                <span>
                                    Ainda não pago
                                </span>
                            }

                        </div>

                    </div>

                    <div class="col-md-6">

                        <strong>
                            Data de criação
                        </strong>

                        <div class="text-muted">
                            @Model.DataCriacao.ToString("dd/MM/yyyy HH:mm")
                        </div>

                    </div>

                    <div class="col-md-6">

                        <strong>
                            Situação
                        </strong>

                        <div>

                            @if (Model.IsAtivo)
                            {
                                <span class="text-success fw-semibold">
                                    Ativo
                                </span>
                            }
                            else
                            {
                                <span class="text-danger fw-semibold">
                                    Inativo
                                </span>
                            }

                        </div>

                    </div>

                    <div class="col-12">

                        <strong>
                            Observações
                        </strong>

                        <div class="text-muted mt-1">

                            @if (!string.IsNullOrWhiteSpace(Model.Observacoes))
                            {
                                @Model.Observacoes
                            }
                            else
                            {
                                <span>
                                    Nenhuma observação.
                                </span>
                            }

                        </div>

                    </div>

                </div>

                <hr class="my-4" />

                <div class="d-flex gap-2 flex-wrap align-items-center">

                    @if (Model.Status == 1)
                    {
                        <form asp-controller="Pagamentos"
                              asp-action="MarcarComoPago"
                              method="post">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="id"
                                   value="@Model.Id" />

                            <button type="submit"
                                    class="btn btn-success">
                                Marcar como Pago
                            </button>

                        </form>

                        <form asp-controller="Pagamentos"
                              asp-action="Cancelar"
                              method="post">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="id"
                                   value="@Model.Id" />

                            <button type="submit"
                                    class="btn btn-danger"
                                    onclick="return confirm('Deseja realmente cancelar este pagamento?');">
                                Cancelar Pagamento
                            </button>

                        </form>
                    }

                    @if (Model.Status == 2)
                    {
                        <form asp-controller="Pagamentos"
                              asp-action="Estornar"
                              method="post"
                              onsubmit="return confirm('@(ehEntrada
                                                              ? "Deseja realmente estornar a entrada desta reserva?"
                                                              : "Deseja realmente estornar este pagamento?")');">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="id"
                                   value="@Model.Id" />

                            <button type="submit"
                                    class="btn btn-warning">
                                @(ehEntrada
                                    ? "Estornar Entrada"
                                    : "Estornar Pagamento")
                            </button>

                        </form>

                        @if (ehEntrada)
                        {
                            <div class="alert alert-warning mb-0">

                                <strong>
                                    Entrada paga.
                                </strong>

                                O estorno mantém o pagamento no histórico,
                                mas altera seu status para estornado.

                            </div>
                        }
                    }

                    @if (Model.Status == 3)
                    {
                        <div class="alert alert-danger mb-0">
                            Este pagamento foi cancelado.
                        </div>
                    }

                    @if (Model.Status == 4)
                    {
                        <div class="alert alert-secondary mb-0">

                            <strong>
                                Pagamento estornado.
                            </strong>

                            Este registro permanece no histórico financeiro.

                        </div>
                    }

                </div>

            </div>

        </div>

    </div>
</section>