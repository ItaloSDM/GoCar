@model GoCar.Web.Models.CategoriaViewModel

@{
    ViewData["Title"] = "Editar Categoria";
}

<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1>Editar Categoria</h1>

            <p class="text-muted mb-0">
                Atualize as informações da categoria.
            </p>
        </div>

        <a class="btn btn-outline-light"
           asp-controller="Categorias"
           asp-action="Index">

            Cancelar
        </a>

    </div>

    <div class="card border-0 shadow-sm">

        <div class="card-body">

            <form asp-controller="Categorias"
                  asp-action="Editar"
                  asp-route-id="@Model.Id"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       asp-for="Id" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="row g-3">

                    <div class="col-md-6">

                        <label asp-for="Nome"
                               class="form-label">
                            Nome
                        </label>

                        <input asp-for="Nome"
                               class="form-control" />

                        <span asp-validation-for="Nome"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-md-3">

                        <label asp-for="DiariaBase"
                               class="form-label">
                            Diária Base
                        </label>

                        <input asp-for="DiariaBase"
                               type="number"
                               step="0.01"
                               min="0"
                               class="form-control" />

                        <span asp-validation-for="DiariaBase"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-md-3">

                        <label asp-for="KmLivre"
                               class="form-label">
                            KM Livre
                        </label>

                        <input asp-for="KmLivre"
                               type="number"
                               min="0"
                               class="form-control" />

                        <span asp-validation-for="KmLivre"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-12">

                        <label asp-for="Descricao"
                               class="form-label">
                            Descrição
                        </label>

                        <textarea asp-for="Descricao"
                                  class="form-control"
                                  rows="4">
                        </textarea>

                        <span asp-validation-for="Descricao"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-12">

                        <div class="form-check">

                            <input asp-for="IsAtivo"
                                   class="form-check-input" />

                            <label asp-for="IsAtivo"
                                   class="form-check-label">

                                Categoria ativa
                            </label>

                        </div>

                    </div>

                </div>

                <div class="mt-4">

                    <button type="submit"
                            class="btn btn-dark">

                        Salvar Alterações
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}