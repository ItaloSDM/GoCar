@model GoCar.Web.Models.CategoriaViewModel

@{
    ViewData["Title"] = "Nova Categoria";
}

<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1>Nova Categoria</h1>

            <p class="text-muted mb-0">
                Cadastre uma nova categoria de veículo.
            </p>
        </div>

        <a class="btn btn-outline-light"
           asp-controller="Categorias"
           asp-action="Index">

            Cancelar
        </a>

    </div>

    <div class="card border-0 shadow-sm">

        <div class="card-body">

            <form asp-controller="Categorias"
                  asp-action="Criar"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="row g-3">

                    <div class="col-md-6">

                        <label asp-for="Nome"
                               class="form-label">
                            Nome
                        </label>

                        <input asp-for="Nome"
                               class="form-control"
                               placeholder="Ex.: Econômico" />

                        <span asp-validation-for="Nome"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-md-3">

                        <label asp-for="DiariaBase"
                               class="form-label">
                            Diária Base
                        </label>

                        <input asp-for="DiariaBase"
                               type="number"
                               step="0.01"
                               min="0"
                               class="form-control" />

                        <span asp-validation-for="DiariaBase"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-md-3">

                        <label asp-for="KmLivre"
                               class="form-label">
                            KM Livre
                        </label>

                        <input asp-for="KmLivre"
                               type="number"
                               min="0"
                               class="form-control" />

                        <span asp-validation-for="KmLivre"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-12">

                        <label asp-for="Descricao"
                               class="form-label">
                            Descrição
                        </label>

                        <textarea asp-for="Descricao"
                                  class="form-control"
                                  rows="4"
                                  placeholder="Descrição da categoria...">
                        </textarea>

                        <span asp-validation-for="Descricao"
                              class="text-danger">
                        </span>

                    </div>

                </div>

                <div class="mt-4">

                    <button type="submit"
                            class="btn btn-dark">

                        Cadastrar Categoria
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}