@model GoCar.Web.Models.CategoriaViewModel

@{
    ViewData["Title"] = "Nova Categoria";
}

<style>
    .category-create-page {
        max-width: 1500px;
        margin: auto;
        padding: 32px;
        color: #fff;
    }

    .category-create-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 24px;
    }

    .category-create-eyebrow {
        color: #8d849a;
        font-size: .7rem;
        text-transform: uppercase;
        letter-spacing: .6px;
        margin-bottom: 4px;
    }

    .category-create-title {
        margin: 0;
        font-size: 1.85rem;
        font-weight: 800;
    }

    .category-create-description {
        margin: 6px 0 0;
        color: #81778e;
        font-size: .8rem;
    }

    .create-btn,
    .create-btn-primary {
        min-height: 40px;
        padding: 0 16px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        text-decoration: none;
        font-size: .7rem;
        font-weight: 700;
    }

    .create-btn {
        border: 1px solid rgba(151,71,255,.24);
        background: rgba(126,44,255,.06);
        color: #bca9d4;
    }

        .create-btn:hover {
            color: #fff;
            background: rgba(126,44,255,.12);
        }

    .create-btn-primary {
        border: 1px solid #8b3dff;
        background: linear-gradient(135deg,#7c2cff,#9b4dff);
        color: #fff;
        cursor: pointer;
    }

    .category-create-intro {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 16px;
        padding: 22px 24px;
        border: 1px solid rgba(151,71,255,.16);
        border-radius: 11px;
        background: radial-gradient(circle at 90% 20%,rgba(126,44,255,.13),transparent 32%), linear-gradient(145deg,rgba(21,11,37,.98),rgba(13,7,24,.98));
    }

        .category-create-intro small {
            display: block;
            color: #9a6dde;
            font-size: .56rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .6px;
            margin-bottom: 4px;
        }

        .category-create-intro h2 {
            margin: 0;
            font-size: 1rem;
            font-weight: 700;
        }

        .category-create-intro p {
            margin: 6px 0 0;
            color: #776d82;
            font-size: .64rem;
        }

    .category-create-icon {
        width: 55px;
        height: 55px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex: 0 0 55px;
        border-radius: 12px;
        border: 1px solid rgba(151,71,255,.2);
        background: rgba(126,44,255,.08);
        color: #b76cff;
        font-size: 1.5rem;
    }

    .category-create-card {
        overflow: hidden;
        border: 1px solid rgba(151,71,255,.16);
        border-radius: 11px;
        background: linear-gradient(145deg,rgba(21,11,37,.98),rgba(13,7,24,.98));
    }

    .category-create-section {
        padding: 22px;
    }

    .category-create-grid {
        display: grid;
        grid-template-columns: repeat(12,minmax(0,1fr));
        gap: 15px;
    }

    .create-col-3 {
        grid-column: span 3;
    }

    .create-col-6 {
        grid-column: span 6;
    }

    .create-col-12 {
        grid-column: span 12;
    }

    .create-field label {
        display: block;
        margin-bottom: 6px;
        color: #aaa0b5;
        font-size: .62rem;
        font-weight: 700;
    }

    .create-input {
        width: 100%;
        min-height: 41px;
        padding: 9px 11px;
        border: 1px solid rgba(151,71,255,.17);
        border-radius: 7px;
        outline: none;
        background: rgba(255,255,255,.025);
        color: #ded8e5;
        font-size: .7rem;
    }

    textarea.create-input {
        min-height: 115px;
        resize: vertical;
    }

    .create-input:focus {
        border-color: rgba(151,71,255,.65);
        background: rgba(126,44,255,.045);
        box-shadow: 0 0 0 3px rgba(126,44,255,.07);
    }

    .create-input::placeholder {
        color: #51495a;
    }

    .create-validation {
        display: block;
        margin-top: 5px;
        color: #ff718d;
        font-size: .56rem;
    }

    .validation-summary-errors {
        margin-bottom: 18px;
        padding: 12px 14px;
        border: 1px solid rgba(244,63,94,.22);
        border-radius: 8px;
        background: rgba(244,63,94,.07);
        color: #ff91a7;
        font-size: .65rem;
    }

    .category-create-footer {
        display: flex;
        justify-content: flex-end;
        gap: 8px;
        padding: 18px 22px;
        border-top: 1px solid rgba(255,255,255,.045);
        background: rgba(6,3,11,.22);
    }

    @@media (max-width: 700px) {
        .category-create-page {
            padding: 20px 15px;
        }

        .category-create-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .create-col-3,
        .create-col-6 {
            grid-column: span 12;
        }

        .category-create-icon {
            display: none;
        }

        .category-create-footer {
            flex-direction: column-reverse;
        }

            .category-create-footer a,
            .category-create-footer button {
                width: 100%;
            }
    }
</style>

<div class="category-create-page">

    <div class="category-create-header">

        <div>
            <div class="category-create-eyebrow">
                Gestão da frota
            </div>

            <h1 class="category-create-title">
                Nova Categoria
            </h1>

            <p class="category-create-description">
                Cadastre uma nova categoria para os veículos.
            </p>
        </div>

        <a asp-controller="Categorias"
           asp-action="Index"
           class="create-btn">
            ← Voltar
        </a>

    </div>

    <div class="category-create-intro">

        <div>
            <small>Nova categoria</small>

            <h2>
                Informações da categoria
            </h2>

            <p>
                Defina o nome, valor base, quilometragem e descrição.
            </p>
        </div>

        <div class="category-create-icon">
            +
        </div>

    </div>

    <div class="category-create-card">

        <form asp-controller="Categorias"
              asp-action="Criar"
              method="post">

            @Html.AntiForgeryToken()

            <div class="category-create-section">

                <div asp-validation-summary="ModelOnly">
                </div>

                <div class="category-create-grid">

                    <div class="create-field create-col-6">

                        <label asp-for="Nome">
                            Nome
                        </label>

                        <input asp-for="Nome"
                               class="create-input"
                               placeholder="Ex.: Econômico" />

                        <span asp-validation-for="Nome"
                              class="create-validation">
                        </span>

                    </div>

                    <div class="create-field create-col-3">

                        <label asp-for="DiariaBase">
                            Diária Base
                        </label>

                        <input asp-for="DiariaBase"
                               type="number"
                               step="0.01"
                               min="0"
                               class="create-input"
                               placeholder="0,00" />

                        <span asp-validation-for="DiariaBase"
                              class="create-validation">
                        </span>

                    </div>

                    <div class="create-field create-col-3">

                        <label asp-for="KmLivre">
                            KM Livre
                        </label>

                        <input asp-for="KmLivre"
                               type="number"
                               min="0"
                               class="create-input"
                               placeholder="0" />

                        <span asp-validation-for="KmLivre"
                              class="create-validation">
                        </span>

                    </div>

                    <div class="create-field create-col-12">

                        <label asp-for="Descricao">
                            Descrição
                        </label>

                        <textarea asp-for="Descricao"
                                  class="create-input"
                                  rows="4"
                                  placeholder="Descrição da categoria..."></textarea>

                        <span asp-validation-for="Descricao"
                              class="create-validation">
                        </span>

                    </div>

                </div>

            </div>

            <div class="category-create-footer">

                <a asp-controller="Categorias"
                   asp-action="Index"
                   class="create-btn">
                    Cancelar
                </a>

                <button type="submit"
                        class="create-btn-primary">
                    Cadastrar Categoria
                </button>

            </div>

        </form>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}