@model GoCar.Web.Models.HomeViewModel
@using GoCar.Web.Controllers

@{
    ViewData["Title"] = "Início";

    var gruposVeiculos =
        ViewBag.GruposVeiculos
            as List<HomeController.HomeVeiculoGrupoViewModel>
        ?? new List<HomeController.HomeVeiculoGrupoViewModel>();

    int? filialSelecionadaId =
        ViewBag.FilialSelecionadaId as int?;

    DateTime? dataRetirada =
        ViewBag.DataRetirada as DateTime?;

    DateTime? dataDevolucao =
        ViewBag.DataDevolucao as DateTime?;

    bool buscaRealizada =
        ViewBag.BuscaRealizada is bool br && br;

    bool buscaValida =
        ViewBag.BuscaValida is bool bv && bv;

    string? erroBusca =
        ViewBag.ErroBusca as string;

    var gruposDestaque =
        gruposVeiculos
            .OrderByDescending(v => v.QuantidadeDisponivel)
            .ThenBy(v => v.ValorDiaria)
            .Take(5)
            .ToList();

    string ImagemVeiculo(string categoria)
    {
        var nome =
            (categoria ?? string.Empty)
                .ToLowerInvariant();

        if (nome.Contains("suv"))
            return "/images/veiculos/suv.png";

        if (nome.Contains("sedan"))
            return "/images/veiculos/sedan.png";

        if (nome.Contains("hatch"))
            return "/images/veiculos/hatch.png";

        if (nome.Contains("econ"))
            return "/images/veiculos/economico.png";

        return "/images/veiculos/sedan.png";
    }

    string CambioVeiculo(int cambio)
    {
        return cambio switch
        {
            1 => "Manual",
            2 => "Automático",
            _ => "Câmbio"
        };
    }

    string CombustivelVeiculo(int combustivel)
    {
        return combustivel switch
        {
            1 => "Flex",
            2 => "Gasolina",
            3 => "Etanol",
            4 => "Diesel",
            5 => "Elétrico",
            6 => "Híbrido",
            _ => "Combustível"
        };
    }
}


<!-- =========================================================
     HERO / BANNER OFICIAL + BUSCA SOBRE A IMAGEM
========================================================== -->

<section class="home-hero"
         id="reserva">

    <img src="~/images/cabecalho/fundo banner.png"
         alt="GoCar - Seu próximo destino começa aqui"
         class="home-hero-background" />

    <div class="home-hero-overlay">
    </div>

    <div class="home-search-overlay">

        <div class="container">

            @if (!string.IsNullOrWhiteSpace(erroBusca))
            {
                <div class="home-search-alert">

                    <span>
                        !
                    </span>

                    @erroBusca

                </div>
            }

            <form asp-controller="Home"
                  asp-action="Index"
                  method="get"
                  class="home-search-form">

                <!-- LOCAL -->

                <div class="home-search-field home-search-location">

                    <label for="filialId">
                        Local de retirada
                    </label>

                    <div class="home-search-control">

                        <span class="home-search-icon">
                            ●
                        </span>

                        <select id="filialId"
                                name="filialId"
                                required>

                            <option value="">
                                Onde você quer retirar o carro?
                            </option>

                            @foreach (var filial in Model.Filiais)
                            {
                                if (filialSelecionadaId == filial.Id)
                                {
                                    <option value="@filial.Id"
                                            selected>
                                        @filial.Nome - @filial.Cidade/@filial.Estado
                                    </option>
                                }
                                else
                                {
                                    <option value="@filial.Id">
                                        @filial.Nome - @filial.Cidade/@filial.Estado
                                    </option>
                                }
                            }

                        </select>

                    </div>

                </div>


                <!-- RETIRADA -->

                <div class="home-search-field">

                    <label for="dataRetirada">
                        Retirada
                    </label>

                    <div class="home-search-control">

                        <span class="home-search-icon">
                            ▣
                        </span>

                        <input id="dataRetirada"
                               name="dataRetirada"
                               type="date"
                               min="@DateTime.Today.ToString("yyyy-MM-dd")"
                               value="@(dataRetirada?.ToString("yyyy-MM-dd"))"
                               required />

                    </div>

                </div>


                <!-- DEVOLUÇÃO -->

                <div class="home-search-field">

                    <label for="dataDevolucao">
                        Devolução
                    </label>

                    <div class="home-search-control">

                        <span class="home-search-icon">
                            ◷
                        </span>

                        <input id="dataDevolucao"
                               name="dataDevolucao"
                               type="date"
                               min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")"
                               value="@(dataDevolucao?.ToString("yyyy-MM-dd"))"
                               required />

                    </div>

                </div>


                <!-- BOTÃO -->

                <button type="submit"
                        class="home-search-button">

                    <span>
                        Buscar
                    </span>

                    <strong>
                        →
                    </strong>

                </button>

            </form>

        </div>

    </div>

</section>


<!-- =========================================================
     BENEFÍCIOS
========================================================== -->

<section class="home-benefits"
         id="como-funciona">

    <div class="container">

        <div class="home-benefits-grid">

            <!-- BENEFÍCIO 1 -->

            <article class="home-benefit">

                <div class="home-benefit-icon">

                    <span>
                        ▣
                    </span>

                </div>

                <div>

                    <h3>
                        Retirada Digital Rápida
                    </h3>

                    <p>
                        Retire seu carro com mais agilidade,
                        sem burocracia.
                    </p>

                    <a href="#frota">
                        Saiba mais
                    </a>

                </div>

            </article>


            <!-- BENEFÍCIO 2 -->

            <article class="home-benefit">

                <div class="home-benefit-icon">

                    <span>
                        ◆
                    </span>

                </div>

                <div>

                    <h3>
                        Adicionais
                    </h3>

                    <p>
                        Tudo para deixar sua viagem
                        mais confortável e tranquila.
                    </p>

                    <a href="#frota">
                        Saiba mais
                    </a>

                </div>

            </article>


            <!-- BENEFÍCIO 3 -->

            <article class="home-benefit">

                <div class="home-benefit-icon">

                    <span>
                        ●
                    </span>

                </div>

                <div>

                    <h3>
                        Portal do Cliente
                    </h3>

                    <p>
                        Suas reservas e informações
                        reunidas em um só lugar.
                    </p>

                    <a asp-controller="Reservas"
                       asp-action="Index">
                        Saiba mais
                    </a>

                </div>

            </article>

        </div>

    </div>

</section>


<!-- =========================================================
     FROTA
========================================================== -->

<section class="home-fleet"
         id="frota">

    <div class="container">

        <div class="home-section-heading">

            <span>
                NOSSOS VEÍCULOS
            </span>

            <h2>
                Conheça a nossa Frota
            </h2>

            @if (buscaRealizada && buscaValida)
            {
                <p>
                    Confira os veículos disponíveis
                    para o período selecionado.
                </p>
            }
            else
            {
                <p>
                    As melhores condições para você
                    reservar e aproveitar.
                </p>
            }

        </div>


        @if (buscaRealizada &&
             buscaValida &&
             filialSelecionadaId.HasValue)
        {
            var filialSelecionada =
                Model.Filiais.FirstOrDefault(
                    f => f.Id == filialSelecionadaId.Value);

            <div class="home-search-result">

                <div>

                    <span class="home-result-dot">
                    </span>

                    <strong>
                        Busca realizada
                    </strong>

                    @if (filialSelecionada != null)
                    {
                        <span>
                            • @filialSelecionada.Nome
                        </span>
                    }

                    @if (dataRetirada.HasValue &&
                         dataDevolucao.HasValue)
                    {
                        <span>
                            • @dataRetirada.Value.ToString("dd/MM/yyyy")
                            até
                            @dataDevolucao.Value.ToString("dd/MM/yyyy")
                        </span>
                    }

                </div>

                <a asp-controller="Home"
                   asp-action="Index">

                    Limpar busca

                </a>

            </div>
        }


        @if (gruposDestaque.Any())
        {
            <div class="home-fleet-carousel">

                <button type="button"
                        class="home-fleet-arrow home-fleet-arrow-left"
                        id="fleetPrev"
                        aria-label="Veículo anterior">

                    ‹

                </button>


                <div class="home-fleet-track"
                     id="fleetTrack">

                    @for (var i = 0; i < gruposDestaque.Count; i++)
                    {
                        var veiculo =
                            gruposDestaque[i];

                        <article class="home-fleet-card @(i == 0 ? "active" : "")"
                                 data-fleet-index="@i">

                            <div class="home-fleet-image">

                                <div class="home-car-glow">
                                </div>

                                <img src="@ImagemVeiculo(veiculo.CategoriaNome)"
                                     alt="@veiculo.Marca @veiculo.Modelo" />

                            </div>


                            <div class="home-fleet-card-body">

                                <span class="home-fleet-category">
                                    @veiculo.CategoriaNome
                                </span>

                                <h3>
                                    @veiculo.Marca @veiculo.Modelo
                                </h3>

                                <p class="home-fleet-similar">
                                    Grupo @veiculo.CategoriaNome
                                </p>


                                <div class="home-fleet-specs">

                                    <span>
                                        <strong>●</strong>
                                        @CombustivelVeiculo(veiculo.Combustivel)
                                    </span>

                                    <span>
                                        <strong>◆</strong>
                                        @CambioVeiculo(veiculo.Cambio)
                                    </span>

                                    <span>
                                        <strong>▣</strong>
                                        @veiculo.AnoModelo
                                    </span>

                                </div>


                                <div class="home-fleet-price">

                                    <span>
                                        A partir de
                                    </span>

                                    <div>

                                        <strong>
                                            @veiculo.ValorDiaria.ToString("C")
                                        </strong>

                                        <small>
                                            /dia
                                        </small>

                                    </div>

                                </div>


                                @if (buscaRealizada &&
                                     buscaValida &&
                                     filialSelecionadaId.HasValue &&
                                     dataRetirada.HasValue &&
                                     dataDevolucao.HasValue)
                                {
                                    <a asp-controller="Reservas"
                                       asp-action="Criar"
                                       asp-route-veiculoId="@veiculo.VeiculoId"
                                       asp-route-filialId="@filialSelecionadaId.Value"
                                       asp-route-dataRetirada="@dataRetirada.Value.ToString("yyyy-MM-dd")"
                                       asp-route-dataDevolucao="@dataDevolucao.Value.ToString("yyyy-MM-dd")"
                                       class="home-fleet-reserve">

                                        Reservar este carro

                                    </a>
                                }
                                else
                                {
                                    <a href="#reserva"
                                       class="home-fleet-reserve">

                                        Consultar disponibilidade

                                    </a>
                                }

                            </div>

                        </article>
                    }

                </div>


                <button type="button"
                        class="home-fleet-arrow home-fleet-arrow-right"
                        id="fleetNext"
                        aria-label="Próximo veículo">

                    ›

                </button>

            </div>


            <div class="home-fleet-dots"
                 id="fleetDots">

                @for (var i = 0; i < gruposDestaque.Count; i++)
                {
                    <button type="button"
                            class="@(i == 0 ? "active" : "")"
                            data-fleet-dot="@i"
                            aria-label="Ir para veículo @(i + 1)">
                    </button>
                }

            </div>


            <div class="home-fleet-all">

                <a href="#todos-veiculos">

                    Confira todos os grupos

                </a>

            </div>
        }
        else
        {
            <div class="home-fleet-empty">

                <div>
                    !
                </div>

                <h3>
                    Nenhum veículo encontrado
                </h3>

                @if (buscaRealizada)
                {
                    <p>
                        Não encontramos veículos disponíveis
                        para esse período. Tente alterar a filial
                        ou as datas da sua busca.
                    </p>
                }
                else
                {
                    <p>
                        Nenhum veículo está disponível
                        no momento.
                    </p>
                }

                <a href="#reserva">
                    Fazer outra busca
                </a>

            </div>
        }

    </div>

</section>


<!-- =========================================================
     TODOS OS VEÍCULOS
========================================================== -->

<section class="home-all-vehicles"
         id="todos-veiculos">

    <div class="container">

        <div class="home-section-heading home-section-heading-light">

            <span>
                ESCOLHA O SEU
            </span>

            <h2>
                Encontre o carro ideal
            </h2>

            <p>
                Veja os grupos disponíveis e escolha
                o veículo que combina com a sua viagem.
            </p>

        </div>


        @if (gruposVeiculos.Any())
        {
            <div class="home-vehicle-grid">

                @foreach (var veiculo in gruposVeiculos)
                {
                    <article class="home-vehicle-card">

                        <div class="home-vehicle-card-image">

                            <span class="home-vehicle-stock">

                                @veiculo.QuantidadeDisponivel
                                disponível@(veiculo.QuantidadeDisponivel == 1 ? "" : "is")

                            </span>

                            <img src="@ImagemVeiculo(veiculo.CategoriaNome)"
                                 alt="@veiculo.Marca @veiculo.Modelo" />

                        </div>


                        <div class="home-vehicle-card-content">

                            <span class="home-vehicle-category">
                                @veiculo.CategoriaNome
                            </span>

                            <h3>
                                @veiculo.Marca @veiculo.Modelo
                            </h3>


                            <div class="home-vehicle-card-specs">

                                <span>
                                    @CambioVeiculo(veiculo.Cambio)
                                </span>

                                <span>
                                    @CombustivelVeiculo(veiculo.Combustivel)
                                </span>

                                <span>
                                    @veiculo.AnoModelo
                                </span>

                            </div>


                            <div class="home-vehicle-card-footer">

                                <div>

                                    <small>
                                        A partir de
                                    </small>

                                    <strong>
                                        @veiculo.ValorDiaria.ToString("C")
                                    </strong>

                                    <span>
                                        /dia
                                    </span>

                                </div>


                                @if (buscaRealizada &&
                                     buscaValida &&
                                     filialSelecionadaId.HasValue &&
                                     dataRetirada.HasValue &&
                                     dataDevolucao.HasValue)
                                {
                                    <a asp-controller="Reservas"
                                       asp-action="Criar"
                                       asp-route-veiculoId="@veiculo.VeiculoId"
                                       asp-route-filialId="@filialSelecionadaId.Value"
                                       asp-route-dataRetirada="@dataRetirada.Value.ToString("yyyy-MM-dd")"
                                       asp-route-dataDevolucao="@dataDevolucao.Value.ToString("yyyy-MM-dd")">

                                        Reservar

                                    </a>
                                }
                                else
                                {
                                    <a href="#reserva">
                                        Consultar
                                    </a>
                                }

                            </div>

                        </div>

                    </article>
                }

            </div>
        }

    </div>

</section>


<!-- =========================================================
     SOBRE / CTA
========================================================== -->

<section class="home-about"
         id="sobre">

    <div class="container">

        <div class="home-about-content">

            <div>

                <span>
                    POR QUE GOCAR?
                </span>

                <h2>
                    Seu caminho,
                    <strong>
                        suas escolhas.
                    </strong>
                </h2>

            </div>


            <p>
                Da reserva à retirada, a GoCar foi criada
                para tornar sua experiência mais simples.
                Escolha o veículo, defina o período e
                aproveite o caminho.
            </p>


            <a href="#reserva">

                Reserve agora

                <span>
                    →
                </span>

            </a>

        </div>

    </div>

</section>


<!-- =========================================================
     CSS ESPECÍFICO DA HOME
========================================================== -->

<style>

    /* =====================================================
           HERO / BANNER OFICIAL
           ===================================================== */

    .home-hero {
        position: relative;
        width: 100%;
        aspect-ratio: 1920 / 650;
        min-height: 540px;
        overflow: hidden;
        background: #100017;
    }

    .home-hero-background {
        position: absolute;
        z-index: 1;
        inset: 0;
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center center;
    }

    .home-hero-overlay {
        position: absolute;
        z-index: 2;
        inset: 0;
        pointer-events: none;
        background: linear-gradient( 180deg, rgba(20,0,28,.18) 0%, rgba(20,0,28,.03) 24%, rgba(20,0,28,0) 48%, rgba(20,0,28,.05) 100% );
    }


    /* =====================================================
           BUSCA SOBRE A IMAGEM
           ===================================================== */

    .home-search-overlay {
        position: absolute;
        z-index: 20;
        top: 0;
        left: 0;
        right: 0;
        padding: 26px 0 30px;
        background: linear-gradient( 180deg, rgba(31,0,40,.70) 0%, rgba(31,0,40,.48) 72%, rgba(31,0,40,.18) 100% );
        border-bottom: 1px solid rgba(255,255,255,.08);
        backdrop-filter: blur(2px);
    }

    .home-search-alert {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 14px;
        padding: 12px 15px;
        color: #ffd7dc;
        background: rgba(92,13,27,.78);
        border: 1px solid rgba(248,113,113,.28);
        border-radius: 6px;
        font-size: 14px;
    }

        .home-search-alert > span {
            display: grid;
            place-items: center;
            width: 22px;
            height: 22px;
            border-radius: 50%;
            background: #ef4444;
            color: #fff;
            font-weight: 800;
        }

    .home-search-form {
        display: grid;
        grid-template-columns: minmax(330px, 1.7fr) minmax(190px, .82fr) minmax(190px, .82fr) 150px;
        align-items: end;
        gap: 13px;
    }

    .home-search-field label {
        display: block;
        margin: 0 0 9px 2px;
        color: #fff;
        font-size: 13px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .055em;
        text-shadow: 0 2px 8px rgba(0,0,0,.55);
    }

    .home-search-control {
        display: flex;
        align-items: center;
        height: 56px;
        overflow: hidden;
        background: rgba(255,255,255,.98);
        border: 1px solid rgba(255,255,255,.7);
        border-radius: 5px;
        box-shadow: 0 8px 24px rgba(0,0,0,.20);
    }

    .home-search-icon {
        flex: 0 0 48px;
        display: grid;
        place-items: center;
        height: 100%;
        color: #7c1cb2;
        font-size: 16px;
    }

    .home-search-control select,
    .home-search-control input {
        width: 100%;
        height: 100%;
        padding: 0 14px 0 0;
        color: #4b4452;
        background: transparent;
        border: 0;
        outline: none;
        font-size: 15px;
        font-weight: 500;
    }

    .home-search-button {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 15px;
        height: 56px;
        padding: 0 21px;
        color: #fff;
        background: linear-gradient(135deg, #7b1cb2, #a12ed5);
        border: 1px solid rgba(255,255,255,.22);
        border-radius: 5px;
        box-shadow: 0 8px 24px rgba(0,0,0,.22);
        font-size: 15px;
        font-weight: 800;
        transition: .2s ease;
    }

        .home-search-button:hover {
            background: linear-gradient(135deg, #8e25c5, #b541e1);
            transform: translateY(-1px);
        }


    /* =====================================================
           BENEFÍCIOS
           ===================================================== */

    .home-benefits {
        color: #fff;
        background: #1d0825;
        border-bottom: 1px solid rgba(255,255,255,.06);
    }

    .home-benefits-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        min-height: 180px;
    }

    .home-benefit {
        display: grid;
        grid-template-columns: 72px 1fr;
        gap: 20px;
        align-items: center;
        padding: 34px 36px;
        border-right: 1px solid rgba(255,255,255,.07);
    }

        .home-benefit:last-child {
            border-right: 0;
        }

    .home-benefit-icon {
        display: grid;
        place-items: center;
        width: 64px;
        height: 64px;
        color: #e0a1ff;
        background: #310b3d;
        border: 1px solid rgba(206,106,255,.20);
        border-radius: 50%;
        font-size: 25px;
    }

    .home-benefit h3 {
        margin: 0 0 8px;
        color: #fff;
        font-size: 18px;
        font-weight: 700;
    }

    .home-benefit p {
        min-height: 40px;
        margin: 0 0 9px;
        color: rgba(255,255,255,.68);
        font-size: 14px;
        line-height: 1.55;
    }

    .home-benefit a {
        color: #d272ff;
        font-size: 13px;
        font-weight: 700;
        text-decoration: underline;
    }


    /* =====================================================
           FROTA
           ===================================================== */

    .home-fleet {
        position: relative;
        padding: 78px 0 88px;
        overflow: hidden;
        color: #fff;
        background: radial-gradient( circle at 50% 48%, rgba(97,24,132,.16), transparent 35% ), #100017;
    }

    .home-section-heading {
        max-width: 700px;
        margin: 0 auto 48px;
        text-align: center;
    }

        .home-section-heading > span {
            display: block;
            margin-bottom: 11px;
            color: #b94fe8;
            font-size: 12px;
            font-weight: 800;
            letter-spacing: .2em;
        }

        .home-section-heading h2 {
            margin: 0;
            color: #fff;
            font-size: clamp(38px, 3.4vw, 48px);
            font-weight: 600;
            letter-spacing: -.03em;
        }

        .home-section-heading p {
            margin: 12px 0 0;
            color: rgba(255,255,255,.62);
            font-size: 15px;
            line-height: 1.6;
        }

    .home-search-result {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        max-width: 850px;
        margin: -20px auto 35px;
        padding: 13px 16px;
        color: rgba(255,255,255,.74);
        background: rgba(255,255,255,.035);
        border: 1px solid rgba(255,255,255,.08);
        border-radius: 6px;
        font-size: 13px;
    }

        .home-search-result > div {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 6px;
        }

    .home-result-dot {
        width: 7px;
        height: 7px;
        background: #b74ce7;
        border-radius: 50%;
        box-shadow: 0 0 10px #b74ce7;
    }

    .home-search-result a {
        color: #d576ff;
        font-size: 13px;
        font-weight: 700;
        text-decoration: none;
    }

    .home-fleet-carousel {
        position: relative;
        max-width: 1180px;
        margin: 0 auto;
    }

    .home-fleet-track {
        position: relative;
        min-height: 500px;
    }

    .home-fleet-card {
