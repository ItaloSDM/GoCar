<!-- =========================================================
     CARROSSEL
========================================================== -->

<script>

    document.addEventListener(
        "DOMContentLoaded",
        function() {

            const cards =
                Array.from(
                    document.querySelectorAll(
                        "[data-fleet-index]"
                    )
                );

            const dots =
                Array.from(
                    document.querySelectorAll(
                        "[data-fleet-dot]"
                    )
                );

            const previousButton =
                document.getElementById(
                    "fleetPrev"
                );

            const nextButton =
                document.getElementById(
                    "fleetNext"
                );

            if (!cards.length) {
                return;
            }

            let currentIndex = 0;


            function normalizeIndex(index) {

                if (index < 0) {
                    return cards.length - 1;
                }

                if (index >= cards.length) {
                    return 0;
                }

                return index;
            }


            function renderCarousel() {

                const previousIndex =
                    normalizeIndex(
                        currentIndex - 1
                    );

                const nextIndex =
                    normalizeIndex(
                        currentIndex + 1
                    );


                cards.forEach(
                    function(card, index) {

                        card.classList.remove(
                            "active",
                            "previous",
                            "next"
                        );

                        if (index === currentIndex) {
                            card.classList.add(
                                "active"
                            );
                        }
                        else if (
                            cards.length > 1 &&
                            index === previousIndex
                        ) {
                            card.classList.add(
                                "previous"
                            );
                        }
                        else if (
                            cards.length > 2 &&
                            index === nextIndex
                        ) {
                            card.classList.add(
                                "next"
                            );
                        }

                    }
                );


                dots.forEach(
                    function(dot, index) {

                        dot.classList.toggle(
                            "active",
                            index === currentIndex
                        );

                    }
                );

            }


            if (previousButton) {

                previousButton.addEventListener(
                    "click",
                    function() {

                        currentIndex =
                            normalizeIndex(
                                currentIndex - 1
                            );

                        renderCarousel();

                    }
                );

            }


            if (nextButton) {

                nextButton.addEventListener(
                    "click",
                    function() {

                        currentIndex =
                            normalizeIndex(
                                currentIndex + 1
                            );

                        renderCarousel();

                    }
                );

            }


            dots.forEach(
                function(dot) {

                    dot.addEventListener(
                        "click",
                        function() {

                            currentIndex =
                                Number(
                                    dot.dataset
                                        .fleetDot
                                );

                            renderCarousel();

                        }
                    );

                }
            );


            renderCarousel();

        }
    );

</script>


